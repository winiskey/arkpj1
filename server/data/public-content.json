  "ruleSections": [
    {
      "id": "section-format",
      "slug": "format",
      "title": "赛制总览",
      "intro": "本次比赛围绕铁人三项式的并行积分赛制展开，每队四人同时推进不同主题挑战。",
      "blocks": [
        {
          "title": "赛制说明",
          "paragraphs": [
            "本次比赛采用铁人三项赛制，同队四位选手分别进行萨米、萨卡兹与界园主题的最高难度集成战略对局。",
            "每队最终得分为所有选手结算分数之和，再乘上队伍总系数。"
          ]
        },
        {
          "title": "作战窗口",
          "items": [
            "每队共 14 小时作战时间，从每个选手最后一次烧水后开始计算，到进入结局关卡前为止。",
            "比赛将于 2026 年 3 月 8 日开赛，是否安排决赛视报名人数决定。"
          ]
        },
        {
          "title": "奖金设置",
          "items": [
            "冠军战队奖金 648 元。",
            "亚军战队奖金 328 元。",
            "其余队伍 120 元 / 队。"
          ]
        }
      ]
    },
    {
      "id": "section-general-rules",
      "slug": "general-rules",
      "title": "通用规则",
      "intro": "这些规则适用于所有队伍和全部主题，是首版赛事站必须完整公开的判定基础。",
      "blocks": [
        {
          "title": "资源与协作限制",
          "items": [
            "每位六星干员在同一队伍的所有选手比赛中仅能被抓取一次，临时招募不计入次数。",
            "商店取钱时全队共享余额，同队所有选手比赛前后减少的源石锭存款数量之和不得超过 200 点。",
            "比赛期间选手与队友之间可申请连麦，每场比赛总次数为 3 次，每次至多 3 分钟。",
            "队内需指定一名抗压位，其最终得分 ×120%。"
          ]
        },
        {
          "title": "开局与重开",
          "items": [
            "开局时不允许选择“获得额外收藏品”的开局奖励。",
            "不允许使用部分分队与随心所欲组合开局，包括蓝图、神人队、roll 效果等分队。",
            "二层行动前可主动重开一次，萨米主题为三层行动前；可烧水至满意或更换账号重新开始，萨米职业队仅能更换账号。"
          ]
        },
        {
          "title": "异常判定",
          "items": [
            "若因断线或设备故障导致对局直接失败，仅在最终即将结束的关卡进行特殊判定。",
            "若最终关卡已完成却掉线，则判为成功，再由裁判手动计算分数。",
            "严禁使用恶性 BUG 与外挂。"
          ]
        }
      ]
    },
    {
      "id": "section-theme-scoring",
      "slug": "theme-scoring",
      "title": "主题计分",
      "intro": "三个主题各有独立的限制条件、关卡加分与最终倍率，请按分主题细读。",
      "blocks": []
    },
    {
      "id": "section-coefficient",
      "slug": "coefficient",
      "title": "总分系数",
      "intro": "所有主题分数汇总后，还会再经过队伍级系数修正。",
      "blocks": [
        {
          "title": "计算公式",
          "paragraphs": [
            "总分 = 四人分数和 × 系数。系数初始值为 1。"
          ]
        },
        {
          "title": "扣减项",
          "items": [
            "每超时 20 分钟，系数 -0.05。",
            "每有一名重复选择的六星干员，系数 -0.1。",
            "商店取钱每超出 1 块，系数 -0.01。"
          ]
        }
      ]
    },
    {
      "id": "section-finals-note",
      "slug": "finals-note",
      "title": "决赛说明",
      "intro": "如果赛事进入决赛阶段，将在基础赛制上做额外调整。",
      "blocks": [
        {
          "title": "追加说明",
          "items": [
            "若存在决赛，决赛将不使用 2.1 规则。",
            "决赛阶段将新增 BP 流程。"
          ]
        }
      ]
    }
  ],
