# Replace `ubuntu` if your SSH user is different.
[Unit]
Description=ArkProject backend service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/arkproject/current
EnvironmentFile=/var/www/arkproject/shared/ark-backend.env
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
