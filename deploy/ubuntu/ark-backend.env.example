# ============================================================
# Ark Backend 环境变量配置
# 使用说明：复制本文件为 ark-backend.env，填写所有必填项
# ============================================================

# 后端监听地址（使用 nginx 反代时保持 127.0.0.1）
API_HOST=127.0.0.1

# 后端监听端口
API_PORT=8787

# [必填] 允许访问 API 的前端域名，多个域名用逗号分隔
# 示例: API_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# 开发时可设为: http://localhost:3000
# 警告：不要设置为 * （会允许任意网站调用管理接口）
API_CORS_ORIGINS=

# [必填] 管理员认证令牌，用于保护所有 /api/admin/* 接口
# 请使用强密码（建议32位以上随机字符串）
# 生成示例：openssl rand -hex 32
# 警告：留空会导致服务拒绝启动
ADMIN_TOKEN=change-this-on-the-server

# 运行时数据目录。留空时默认使用仓库内的 server/data/
# 生产环境建议改到仓库外，例如 /home/admin/ark-data
ARK_DATA_DIR=
